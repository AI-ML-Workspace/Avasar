# Environment Variables — Avasar

# ─── LLM API Keys & Provider Settings ─────────────────────────────────────────
# Active LLM Provider: 'groq', 'gemini', or 'openai'
LLM_PROVIDER=groq

# Groq (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# OpenAI (optional fallback: https://platform.openai.com)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Generation parameters (factual & conservative for government schemes)
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Must include the Next.js dev server origin (default: http://localhost:3000)
CORS_ORIGINS=http://localhost:3000

# ─── Embedding / Vector Store ─────────────────────────────────────────────────
# Path to the FAISS index (relative to backend/)
VECTOR_STORE_PATH=../vector_store/index.faiss

# Sentence Transformers model for multilingual embeddings.
# paraphrase-multilingual-mpnet-base-v2 supports 50+ languages including
# Hindi, Bengali, Tamil, Telugu, Gujarati, Marathi, Kannada, Malayalam, Punjabi.
# Change this value to swap the embedding model without touching code.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# ─── Translation (future) ─────────────────────────────────────────────────────
# Default response language code (ISO 639-1)
DEFAULT_LANGUAGE=en

# ─── Data Ingestion & Chunking ────────────────────────────────────────────────
# Chunk size and overlap in characters for document splitting
CHUNK_SIZE=500
CHUNK_OVERLAP=100
# Optional custom paths (defaults to data/raw and data/processed relative to root)
# RAW_DATA_DIR=data/raw
# PROCESSED_DATA_DIR=data/processed

# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

