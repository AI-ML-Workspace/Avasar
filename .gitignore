.vite/

# ─── Vector Store / ML Artifacts ─────────────────────────────────────────────
vector_store/*.index
vector_store/*.pkl
vector_store/*.bin
*.npy

# Whitelist canonical vector store files for production deployment
!vector_store/index.faiss
!vector_store/index.meta.json
!backend/vector_store/index.faiss
!backend/vector_store/index.meta.json

# ─── Data (large raw files) ───────────────────────────────────────────────────
data/raw/*.pdf
data/raw/*.csv
data/processed/*.pkl
data/processed/*.bin

# Whitelist processed scheme corpus and health data
!data/processed/documents.jsonl
!data/processed/corpus_manifest.json
!backend/data/processed/documents.jsonl
!backend/data/processed/corpus_manifest.json
!data/source_health.json
!backend/data/source_health.json

